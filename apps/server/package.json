{
  "name": "@enchanted/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API for The Enchanted Diary: sessions, PDF ingestion, OCR, embeddings and RAG.",
  "main": "dist/main.js",
  "exports": {
    "./vercel": {
      "source": "./src/vercel.ts",
      "types": "./src/vercel.ts",
      "default": "./dist/vercel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node scripts/start.mjs",
    "db:migrate": "tsx --conditions=source src/db/migrate-cli.ts",
    "db:migrate:build": "node dist/db/migrate-cli.js --if-configured",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@enchanted/shared": "0.1.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@google/genai": "2.26.0",
    "@napi-rs/canvas": "1.0.9",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "fastify": "5.12.5",
    "franc-min": "6.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15"
  }
}
