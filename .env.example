# The Enchanted Diary: configuration.
# Copy this file to .env (next to package.json) and edit it. Every variable is optional except where noted; the
# values shown are the defaults. The server, `npm run db:migrate` and `npm run models:fetch` read .env at start-up;
# a variable that is already set in the real environment always wins over the file. Relative paths resolve
# against the REPOSITORY ROOT, not the directory you start the server from. .env is git-ignored: never commit it
# and never put keys in client code.
#
# ENV_FILE (set in the real environment, not in this file) names another file to load instead of .env, relative
# to the repository root; set it empty to load no file at all (tests and CI do).
# ENV_FILE=/etc/enchanted-diary.env
#
# ON VERCEL do not import this file as it is: set the variables of the README's "Deploying to Vercel" table in the project.
# The lines that would be wrong there (NODE_ENV, TRUST_PROXY, STORAGE_PROVIDER, MAX_UPLOAD_MB, TMP_DIR) are commented out below
# for that reason: their defaults are what the file would say.

# --- Server ------------------------------------------------------------------------------------------------
# NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Set to true behind a reverse proxy so client IPs (rate limits) are read from X-Forwarded-For. Off by default, but ON by
# default on Vercel, which always is one: there, leave it unset. (Setting it to false on Vercel makes every visitor the same
# address, Vercel's own, and the per-address limits become limits on the whole app.)
# TRUST_PROXY=false
# Set by Vercel itself (VERCEL=1), never by hand: the server then runs as a function (no listening process, no timers, a
# read-only disk except /tmp). DATABASE_URL, SESSION_SECRET and STORAGE_PROVIDER=vercel-blob are then required, and the tick
# limits are checked against the 300 s of the function.
# VERCEL=1
# Set by Vercel as well (production, preview or development), never by hand. Anything but production does not migrate the
# database, expire documents or delete blobs, unless ALLOW_PREVIEW_DATA=true says the environment has a database and a Blob
# store of its own (see the README: a preview must never share production's).
# VERCEL_ENV=production
ALLOW_PREVIEW_DATA=false
# REQUIRED in production: at least 32 random characters, for example `openssl rand -hex 32`. In development an
# unset secret is generated at start-up and sessions end when the server restarts.
SESSION_SECRET=
# pino level: fatal, error, warn, info, debug, trace or silent. Question text is only logged at debug.
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------------------------------------
# Empty: embedded PGlite (PostgreSQL in WebAssembly with pgvector), stored in PGLITE_DATA_DIR.
# Set it to use real PostgreSQL with pgvector, for example the docker-compose service (`npm run db:up`):
#   DATABASE_URL=postgres://diary:diary@127.0.0.1:5433/diary
#
# On Vercel: the POOLED connection string of the Neon integration (the one that is DATABASE_URL by default). Migrations
# run in the Vercel build (`npm run vercel-build`) and are checked again when an instance starts.
DATABASE_URL=
# The direct (not pooled) Neon connection: preferred by `npm run db:migrate:build`, since DDL and the advisory lock of the
# migrations belong on a session, not behind PgBouncer. Vercel's Neon integration sets it.
# DATABASE_URL_UNPOOLED=
# Connections of the pool of one process (a serverless instance serves a few requests at a time).
DATABASE_POOL_MAX=3
PGLITE_DATA_DIR=./.data/pglite
# Unused: pgvector lives in DATABASE_URL (listed because the product spec names it).
# VECTOR_DB_URL=

# --- Storage -----------------------------------------------------------------------------------------------
# Scratch space for uploads in flight, rasterisation, the copies of documents the ingestion ticks work on, and test
# runs. Keep it on disk: never os.tmpdir(), which is RAM-backed on many systems. On Vercel it is /tmp/enchanted-diary
# unless set (the only writable place: 500 MB, per instance); a TMP_DIR outside /tmp is refused on Vercel.
# TMP_DIR=./.data/tmp
# local (files in STORAGE_DIR: development, tests, a server of your own) | vercel-blob (a PRIVATE Vercel Blob store: the
# browser uploads straight to it, which gets around the 4.5 MB body limit of a function; needs BLOB_READ_WRITE_TOKEN; REQUIRED
# on Vercel, where the disk is read-only and not shared between instances).
# STORAGE_PROVIDER=local
STORAGE_DIR=./.data/uploads
# Server-only: the read-write token of the private Blob store (also what signs the tokens browsers upload with).
BLOB_READ_WRITE_TOKEN=
# What the app lets itself use of a Blob store (the free one holds 1 GB, allows 2,000 advanced operations and 10,000 reads a
# month, and going over blocks it for 30 days). Counted in the database, for all visitors together; 0 = no limit.
# Over a budget: 429 "the archive is full for today". STORED: the documents plus what the upload tickets that are not settled yet
# (open, used or refused, until an hour after they expire) may still bring. A demo's protection, not a hardened one (README).
BLOB_MAX_TOTAL_MB=800
# Write operations a day. An upload ticket costs 2 of them: the single put the browser makes (a token for a multipart upload is
# refused) and the one put more that a ticket whose document was deleted can still make before it expires. 60 is 30 uploads a day.
BLOB_MAX_WRITES_PER_DAY=60
# How often the file of ONE document may be opened a day (each open reads the store).
FILE_READS_PER_DOC_PER_DAY=20
# Uploaded PDFs are temporary. Retention slides: every access refreshes it, up to the absolute cap.
DOCUMENT_RETENTION_HOURS=24
DOCUMENT_MAX_RETENTION_HOURS=72
CLEANUP_INTERVAL_MINUTES=30

# --- Upload limits and ingestion ---------------------------------------------------------------------------
# 50 MB; 20 MB with STORAGE_PROVIDER=vercel-blob (a single put is one write operation of a small quota, a multipart upload
# several). Leave it unset to get the default that fits the storage.
# MAX_UPLOAD_MB=50
MAX_PAGES=300
# Uploads waiting beyond this many get 429 "The archive is busy".
MAX_QUEUED_JOBS=3
INGEST_CONCURRENCY=1
INGEST_PAGE_TIMEOUT_MS=20000
INGEST_JOB_TIMEOUT_MS=1800000
# Heap limit of the worker thread that parses untrusted PDFs.
INGEST_WORKER_MAX_OLD_MB=768
# Decoded images live outside that heap: a worker that makes the process grow by more than this many MB while it
# reads one page (a decompression bomb of images) is terminated, and that page is recorded as unreadable.
INGEST_WORKER_MAX_RSS_GROWTH_MB=512
# A document is read in short "ticks" (one request of the browser each; the database holds the job, so nothing depends on
# one process staying alive). A tick does as much as fits in this many milliseconds and saves after every unit of work.
INGEST_TICK_BUDGET_MS=45000
# A tick holds the job's lease for this long without renewing it: a tick that dies (an instance that was stopped) is taken
# over after it. INGEST_CONCURRENCY above is how many documents are being read at the same time, over all instances.
INGEST_LEASE_MS=60000
# The most one tick may take, however long a unit of work runs (at most 285000 on Vercel, under the function's maximum duration
# of 300 s: refused at start otherwise; at least 8000 while OCR is on or with STORAGE_PROVIDER=vercel-blob, or no OCR call could
# start and no read of the store could fit in what is left after the 5 s a tick keeps free). A unit that outlasts it (an OCR call, an
# embedding batch with its retries, a read of the store) is bounded by what is left of it and ends by itself; one that is stopped
# counts as an attempt and its time is the job's.
INGEST_TICK_HARD_LIMIT_MS=240000
# Ticks in a row that died holding the lease, or were stopped at the hard limit, after which the document is given up on
# (INGEST_INTERRUPTED).
INGEST_MAX_ATTEMPTS=3

# --- OCR (scanned pages) -----------------------------------------------------------------------------------
# gemini (the default: Google Gemini reads the pages, needs GEMINI_API_KEY; nothing runs on this machine) |
# tesseract (optional, self-hosted: the WebAssembly engine; uses about 0.3 GB while it runs) | none
OCR_PROVIDER=gemini
# The Gemini model that reads pages (OCR_PROVIDER=gemini): a model that takes PDFs and returns text.
OCR_MODEL=gemini-3.5-flash-lite
# Pages sent in one request (OCR_PROVIDER=gemini), as a small PDF cut out of the document: requests are the scarce quota
# of a free key (a few hundred a day), pages are cheap. A page whose entry in the answer is garbled is asked for again,
# alone, once; an answer that leaves a page out or numbers the pages wrongly is discarded and EACH of its pages is asked for
# alone (up to one request more for every page of the batch). A request the service cannot answer (busy, down) is retried
# for a few minutes at most, then its pages are left OCR_PARTIAL. The pages of an encrypted PDF are rendered and sent as
# pictures (they cannot be cut out of the file). A rejected key, an unknown model or a model that refuses every request
# stops the document's OCR at once (check GEMINI_API_KEY and OCR_MODEL).
OCR_PAGES_PER_REQUEST=8
# Pages beyond this are skipped with an OCR_PARTIAL warning.
OCR_MAX_PAGES=60
# The most time OCR may take for one document, in seconds: when it is used up the pages not yet read are skipped with an
# OCR_PARTIAL warning (a page that is slow to render, such as a huge image, costs a core until it is given up on). Over all the
# ticks of a document. At most 600: the time the worker's watchdog gives one request to the model. (The model's DAILY quota is
# not this: the document is parked until the quota starts again and goes on from the pages already read; only a remainder of a
# tenth of the pages, once some page was read, is let go with the warning "daily quota reached".)
OCR_MAX_SECONDS=600
# The rest is for OCR_PROVIDER=tesseract only, except OCR_DPI (see there).
# Candidate language packs (Tesseract codes, "+"-joined) for the first scanned page when the document's own text
# pages name no language: each is tried on that page alone and the one that reads it with the highest confidence is
# used for the rest (both together only when each reads it with more than 60).
OCR_LANGUAGES=eng+ara
# Packs allowed for one extra trial when the first page turns out to be another language. fas and urd are also tried
# whenever the Arabic script wins the first page: the ara pack cannot read the letters of Persian or Urdu.
OCR_EXTRA_LANGUAGES=fra+spa+deu+ita+por+tur+fas+urd
# Language packs (<code>.traineddata.gz). `npm run models:fetch` fills it; a pack that is missing is downloaded once,
# on first use, from the jsDelivr copy of @tesseract.js-data (1 to 3 MB each).
OCR_CACHE_DIR=./.data/tessdata
# Resolution of the rendering Tesseract reads, and, with Gemini, of the pages that are rendered instead of cut out of the
# PDF (those of an encrypted file, or too big to send as they are); a page is never rendered wider or taller than 3000 pixels.
OCR_DPI=200
# A page with fewer extracted characters than this is sent to OCR.
OCR_MIN_CHARS=25

# --- Embeddings --------------------------------------------------------------------------------------------
# gemini (Google Gemini API, needs GEMINI_API_KEY) | openai (any OpenAI-compatible /embeddings endpoint)
EMBEDDING_PROVIDER=gemini
# Empty: gemini-embedding-2 for gemini. REQUIRED for openai (for example text-embedding-3-small).
EMBEDDING_MODEL=
# Size of the stored vectors. Gemini reduces its output to this size and the server re-normalises it to length 1.
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
# Directory for downloaded model files (nothing is downloaded for Gemini; kept so paths under it are scrubbed from errors).
MODEL_CACHE_DIR=./.data/models

# --- Answer model ------------------------------------------------------------------------------------------
# gemini | anthropic | openai (any OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, Groq, the Hugging Face
# router) | none
#   none: no answer model; the diary shows the retrieved passages instead.
LLM_PROVIDER=gemini
# Empty: gemini-3.5-flash-lite for gemini (the free tier gives it about 15 requests a minute and 500 a day; the full
# Flash models only about 5 a minute and 20 a day), claude-sonnet-5-5 for anthropic. REQUIRED for openai.
LLM_MODEL=
# The cheaper model for the small calls around an answer: rewriting a follow-up question and the yes/no grounding
# check. Empty: gemini-3.1-flash-lite for gemini (its own quota bucket), the answer model for every other provider.
LLM_AUX_MODEL=
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
# Server-side only. Never expose these to the browser. GEMINI_API_KEY is also what reads scanned pages (OCR).
GEMINI_API_KEY=
# Requests per minute this server PROCESS may send to Gemini PER MODEL: the answer model (LLM_MODEL), the small model of the
# rewrite and the grounding check (LLM_AUX_MODEL) and the OCR model each have a window of their own, like their quotas (a burst
# of answers does not delay the grounding checks). The OCR worker threads draw on the process-wide OCR window together with
# the main thread, and when OCR_MODEL is the same model as LLM_MODEL (or LLM_AUX_MODEL) that one window serves both: one Google
# quota is never given two. Embeddings are paced on their own, by texts per minute. A call waits for a free slot instead of being
# refused (the wait is not counted in its timeout, and leaves at once if the visitor goes away); the free tier allows about
# 15 a minute for the lite models. 0 = no pacing. Each running instance of the server (for example each serverless function)
# has a budget of its own: a deployment with several of them divides this.
GEMINI_MAX_RPM=10
# What this app lets itself use of Gemini's FREE daily quotas, counted in the database for all visitors together (the quotas
# are per Google project, and Google does not publish them: read yours at aistudio.google.com/rate-limit and keep these
# about 20% under it). Answers and OCR requests share the 500 requests of the lite model, so 300 + 100; the embedding quota
# counts texts (about 1,000 a day). The day is the Pacific one, like the quotas. When a budget is used up a question is
# refused (429 RATE_LIMITED, "daily quota reached") and a document being read waits for tomorrow (parked). 0 = no limit,
# for a billed project. A question takes its answer and its embedded text once it is ACCEPTED (not for a refused or invalid one)
# and gives back what no request was made for (a question the evidence gate stopped); the rewrite and the grounding check take
# the `aux` budget where they are made, and a used-up aux budget only makes that call fail, never the question.
GEMINI_DAILY_BUDGET_LLM=300
GEMINI_DAILY_BUDGET_EMBED=800
GEMINI_DAILY_BUDGET_OCR=100
# Requests of the small model of the rewrite and the grounding check (LLM_AUX_MODEL): an answer makes up to two. Taken where such
# a call is made; an answer that finds it used up answers without the small call. 400 assumes the small model has a quota bucket
# of its own (about 500 a day: the default LLM_AUX_MODEL does). If LLM_AUX_MODEL is the same model as LLM_MODEL or OCR_MODEL they
# share ONE bucket, and the three budgets (300 + 100 + 400 here) must add up to about 80% of it, not each of them.
GEMINI_DAILY_BUDGET_AUX=400
# true while the Gemini key is a free-tier one: Google may use what is sent (document text, questions, answers) to improve
# its products, and people may review it, so the app tells its visitors (`llm.freeTierNotice` in /api/config). Set false
# for a billed project, whose data terms are stricter.
GEMINI_FREE_TIER=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Used for LLM_PROVIDER=openai and EMBEDDING_PROVIDER=openai.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retrieval ---------------------------------------------------------------------------------------------
RAG_TOP_K=6
RAG_CANDIDATES=24
RAG_CONTEXT_CHAR_BUDGET=16000
RAG_HISTORY_MESSAGES=6
# After retrieval, ask the auxiliary model "does this text contain the answer?" and refuse only on a clear no (it
# fails open: an empty or odd reply never refuses). One more small call per question.
RAG_GROUNDING_CHECK=true
# About 600 to 900 tokens a chunk. The free Gemini embedding quota counts every chunk (about 1,000 a day), so a book only
# fits when chunks are this big; gemini-embedding-2 accepts 8,192 tokens.
CHUNK_TARGET_CHARS=2000
CHUNK_MAX_CHARS=3000
CHUNK_MIN_CHARS=400
CHUNK_OVERLAP_CHARS=200

# --- Abuse limits ------------------------------------------------------------------------------------------
# Requests per minute per IP, across the whole API (counted in the database, so every instance shares the count).
RATE_LIMIT_PER_MINUTE=120
UPLOADS_PER_HOUR=20
UPLOADS_PER_HOUR_PER_IP=10
QUESTIONS_PER_MINUTE=20
# Ticks of one session per minute (the browser ticks one after another while a document is being read: about one a minute
# on the soft budget, a few in a burst). Well under RATE_LIMIT_PER_MINUTE, so that it limits something.
TICKS_PER_MINUTE=60
# The bearer secret of GET /api/cron/retention (Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`: set this
# variable in the project and Vercel does the rest). Without it the endpoint does not exist for anybody. Use something
# long and random: `openssl rand -hex 32`. The cron only does retention (expired documents, unclaimed uploads, old counters).
CRON_SECRET=

# --- Web development ---------------------------------------------------------------------------------------
# Read by the Vite dev server only: where /api is proxied to.
# VITE_API_PROXY=http://127.0.0.1:8787
